# Production generation — production's own key, never CI's
OPENAI_API_KEY=your_openai_api_key_here
# Optional — defaults to gpt-6-luna (ADR-0008); override only to replace a decommissioned model
# OPENAI_MODEL=gpt-6-luna
# Optional — global chat requests per UTC day before the "resting for today" reply (default 1000)
# DAILY_REQUEST_CAP=1000
ALLOWED_ORIGINS=http://localhost:3000
# Eval only — the Groq baseline tool (eval/run_generation.py --provider groq); not needed to serve the API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Eval only — the generation Judge (TypeSafe's Jev); not needed to serve the API
JEV_API_KEY=your_typesafe_api_key_here
# Eval only — OpenAI generation and claim splitting for the generation gate; CI's key, not production's
# (a separate key in the same OpenAI project, under the same hard monthly budget)
OPENAI_CI_API_KEY=your_openai_ci_api_key_here
